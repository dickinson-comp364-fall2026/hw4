{
  "experiment_name": "latitude_v1",
  "seed": 54545,
  "data": {
    "data_csv_path": "data/processed/weather_station_years_300.csv",
    "split_csv_path": "data/processed/station_splits_300.csv",
    "input_len": 365,
    "scale_x": true,
    "scale_y": true
